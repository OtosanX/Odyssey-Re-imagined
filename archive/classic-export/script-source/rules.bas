Function Main(Player as Long) AS LONG

PlayerMessage(Player, "The Rules of Odyssey", Yellow)
PlayerMessage(Player, "1. You must not block players so they cannot move freely.", White)
PlayerMessage(Player, "2. An unguilded may not interfere in a guild fight on a white map.", White)
PlayerMessage(Player, "3. You may not use any sort of program to help you in the game.", White)
PlayerMessage(Player, "4. You may not spam in an obstructive way.", White)
PlayerMessage(Player, "-This means that filling the text box repeatedly is not allowed", Grey)
PlayerMessage(Player, "5. You may not sell/buy/trade accounts.", White)
PlayerMessage(Player, "6. Clerics may not resurrect a player so that they may be killed.", White)
PlayerMessage(Player, "7. You must not abuse any bugs.", White)
PlayerMessage(Player, "- Anything you find should be reported to a God as soon as possible", Grey)
'PlayerMessage(Player, "8. You must not remain in the treasure rooms of quests so as to block others from entering, or to stop equipment from spawning", White)
PlayerMessage(Player, "8. You must not pretend to be a god.", White)

End Function