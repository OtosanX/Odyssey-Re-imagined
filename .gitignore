# Odyssey Reimagined workspace - ignore only generated build outputs and caches
node_modules/
dist/
artifacts/publish/
/artifacts/history-cleanup*/
logs/
.map-library/
.map-library-cache/
.editor-test-profile/
*.log

# Regenerable test screenshots and inspection sheets (not game artwork)
/*-preview.png
/*test-result.txt
/artifacts/scenery/*.png
/artifacts/distribution/*.png
/artifacts/scenery/map-snapshot-fail.txt

# Local identities, saves and running-server state must never be published
community-world/
**/accounts.data*
**/offline-profiles.json*
**/progress-*.json*
**/sessions/
**/positions.json*
**/.server.lock
**/runtime-config.json
**/.env
**/.env.*
server/data/undefined

# Device login and private hosting settings
/community-server.local.json
**/launcher-accounts.json*
**/saved-servers.json

# Regenerable character-art audit previews
/artifacts/characters/*.png
/artifacts/characters/ids.json
